# ============================================================
#  本地开发用的密钥（wrangler pages dev 会读取本文件）
#
#  用法：
#    copy .dev.vars.example .dev.vars
#    然后把 SECRET_KEY 改成随机长字符串
#
#  生产环境不要用这个文件，改用：
#    wrangler pages secret put SECRET_KEY --project-name=inventory
#
#  .dev.vars 已在 .gitignore 中，不会被提交。
# ============================================================

# JWT 签名密钥（务必改掉，可用 openssl rand -hex 32 生成）
SECRET_KEY=dev-only-change-me-to-a-long-random-string

# Token 有效期（分钟）
TOKEN_EXPIRE_MINUTES=480

# 业务时区
APP_TIMEZONE=Asia/Shanghai
