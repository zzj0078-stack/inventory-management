# 默认按内容自动判断文本/二进制，检出时不做转换
* text=auto

# Windows 脚本必须 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# Linux 部署脚本必须 LF，否则 bash 报 "\r: command not found"
*.sh text eol=lf

# PowerShell 脚本按 CRLF
*.ps1 text eol=crlf

# 源码统一 LF（跨平台一致性）
*.py   text eol=lf
*.js   text eol=lf
*.vue  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.db   binary
*.zip  binary
