# ============================================================
#  敏感文件 —— 绝对不能提交
# ============================================================
# 环境变量（含真实 SECRET_KEY）
backend/.env

# SQLite 数据库与 WAL 临时文件
backend/*.db
backend/*.db-shm
backend/*.db-wal
/inventory.db

# 备份 / 上传的商品图片 / 运行日志
backend/backups/
backend/uploads/
backend/logs/

# 一次性迁移标记（每台机器状态不同）
backend/.status_migrated
backend/.sales_status_migrated
backend/.time_fixed
backend/.tax_fixed
backend/.returned_status_migrated

# 部署打包产物
dist_deploy/

# ============================================================
#  构建产物 / 依赖
# ============================================================
frontend/dist/
frontend/node_modules/
frontend/*.log
backend/packages/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ============================================================
#  编辑器 / 操作系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
#  Cloudflare（wrangler）
# ============================================================
# 本地开发密钥（含真实 SECRET_KEY）；生产用 wrangler pages secret put
.dev.vars

# wrangler 本地状态（miniflare 的本地 D1 副本）
.wrangler/

# 构建时的临时目录（系统 Temp 有时会因权限/残留导致构建失败，用它兜底）
.build-tmp/

# ============================================================
#  其它
# ============================================================
*.log
