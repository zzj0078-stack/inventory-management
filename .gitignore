# ============================================================
#  敏感文件 —— 绝对不能提交
# ============================================================
# 环境变量（含真实 SECRET_KEY）
backend/.env

# SQLite 数据库与 WAL 临时文件
backend/*.db
backend/*.db-shm
backend/*.db-wal
/inventory.db

# 备份 / 上传的商品图片 / 运行日志
backend/backups/
backend/uploads/
backend/logs/

# 一次性迁移标记（每台机器状态不同）
backend/.status_migrated
backend/.sales_status_migrated
backend/.time_fixed
backend/.tax_fixed
backend/.returned_status_migrated

# 部署打包产物
dist_deploy/

# ============================================================
#  构建产物 / 依赖
# ============================================================
frontend/dist/
frontend/node_modules/
frontend/*.log
backend/packages/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ============================================================
#  编辑器 / 操作系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
#  其它
# ============================================================
*.log
