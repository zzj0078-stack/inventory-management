# ============================================================
#  敏感文件 —— 绝对不能提交
# ============================================================
# 环境变量（含真实 SECRET_KEY）
backend/.env

# SQLite 数据库与 WAL 临时文件
backend/*.db
backend/*.db-shm
backend/*.db-wal
/inventory.db

# 备份 / 上传的商品图片 / 运行日志
backend/backups/
backend/uploads/
backend/logs/

# 一次性迁移标记（每台机器状态不同）
backend/.status_migrated
backend/.sales_status_migrated
backend/.time_fixed
backend/.tax_fixed
backend/.returned_status_migrated

# 部署打包产物
dist_deploy/

# ============================================================
#  构建产物 / 依赖
# ============================================================
frontend/dist/
frontend/node_modules/
frontend/*.log
backend/packages/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ============================================================
#  编辑器 / 操作系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
#  Cloudflare（wrangler）
# ============================================================
# 本地开发密钥（含真实 SECRET_KEY）；生产用 wrangler pages secret put
.dev.vars

# wrangler 本地状态（miniflare 的本地 D1 副本）
.wrangler/

# 构建时的临时目录（系统 Temp 有时会因权限/残留导致构建失败，用它兜底）
.build-tmp/

# 存量数据迁移产物（含业务数据，由 cf/migrate_sqlite_to_d1.py 生成）
cf/migrate-data.sql
cf/_sqlite_counts.txt

# D1 线上备份（wrangler d1 export 导出，含真实业务数据）
cf/_backup_*.sql

# ============================================================
#  数据导出与测试报告 —— 可能含真实业务数据，绝不提交
# ============================================================
# ⚠️ exported-data.json 里是**真实发票数据**：购销双方名称、统一社会信用代码、
#    发票号码、开票日期、商品明细与金额。它一直躺在项目根目录且未被忽略，
#    任何人执行 git add -A 就会把客户名单和税号推到 GitHub。
exported-data.json

# 各种验证脚本跑出来的报告/快照，常把接口返回的业务数据整段存下来
*-report.json
smoke-*.json
interact-*.json
delta-*.json
cats-*.json
chinese-check.*
verify-text*
meta-check.txt
local-db-report.txt

# 本地验证脚本与截图（浏览器调试、临时迁移脚本 —— 都不是项目代码）
# 截图可能拍到真实业务数据，所以一并忽略。注意：**只是不提交，文件仍在原处**。
cdp-*.js
*-cats*.png
topbar-*.png
build-restore.js
export-sqlite.js
gen-*probe.js
local-db-maintain.js
migrate-data.js
setup-user.js
split-migrate.js
verify-delta-server.js

# 临时调试脚本：名字以下划线开头、放在仓库根或 backend 下的都不是项目代码。
# 其中几个含登录口令/哈希相关代码，绝不能被 git add -A 顺手提交。
/_*.mjs
/_*.js
/_*.py
backend/_*.py
backend/_*.mjs

# ============================================================
#  其它
# ============================================================
*.log

# 移动端截图预览（本地验证产物）
.mobile-preview/
