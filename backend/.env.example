# 数据库（留空则使用 backend/inventory.db）
DATABASE_URL=sqlite:///./inventory.db

# JWT 密钥（生产环境务必修改）
SECRET_KEY=change-me-to-a-long-random-string

# Token 有效期（分钟）
TOKEN_EXPIRE_MINUTES=480

# 服务监听
HOST=0.0.0.0
PORT=3041

# 业务时区（与服务器系统时区无关）
APP_TIMEZONE=Asia/Shanghai

# 前端构建产物目录（存在则后端直接托管，单端口访问）
# FRONTEND_DIST=D:/Harness/public/frontend/dist

# 备份目录
# BACKUP_DIR=D:/Harness/public/backend/backups

# 上传文件目录（商品图片等，通过 /uploads 对外访问）
# UPLOAD_DIR=D:/Harness/public/backend/uploads

# 单个上传文件上限（MB）
MAX_UPLOAD_MB=5
